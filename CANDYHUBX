-- === ระบบการเคลื่อนไหว ย่อหน้าต่าง <-> แสดงตัว C ===
local isAnimating = false
local defaultMainSize = UDim2.new(0, 420, 0, 260)
local lastMainPos = MainFrame.Position

local tweenOut = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
local tweenIn = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

MinimizeBtn.MouseButton1Click:Connect(function()
    if isAnimating then return end
    isAnimating = true
    lastMainPos = MainFrame.Position

    local tweenMain = TweenService:Create(MainFrame, tweenOut, {
        Size = UDim2.new(0, 0, 0, 0),
        Position = LogoBtn.Position
    })
    
    tweenMain:Play()
    tweenMain.Completed:Connect(function()
        MainFrame.Visible = false
        LogoBtn.Visible = true
        
        local tweenLogo = TweenService:Create(LogoBtn, tweenIn, {Size = UDim2.new(0, 52, 0, 52)})
        TweenService:Create(LogoBtn, tweenIn, {TextSize = 32}):Play()
        tweenLogo:Play()
        
        tweenLogo.Completed:Connect(function()
            isAnimating = false
        end)
    end)
end)

LogoBtn.MouseButton1Click:Connect(function()
    if isAnimating then return end
    isAnimating = true

    local tweenLogo = TweenService:Create(LogoBtn, tweenOut, {Size = UDim2.new(0, 0, 0, 0), TextSize = 0})
    tweenLogo:Play()
    
    tweenLogo.Completed:Connect(function()
        LogoBtn.Visible = false
        MainFrame.Position = LogoBtn.Position
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Visible = true

        local tweenMain = TweenService:Create(MainFrame, tweenIn, {
            Size = defaultMainSize,
            Position = lastMainPos
        })
        tweenMain:Play()
        tweenMain.Completed:Connect(function()
            isAnimating = false
        end)
    end)
end)

