-- เอฟเฟกต์ไฟวงแหวน (Glow Pulse)
task.spawn(function()
    while true do
        if LogoBtn.Visible and LogoBtn.Size.X.Offset > 0 then
            local pOut = TweenService:Create(GlowStroke, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.7, Thickness = 3.5})
            local pIn = TweenService:Create(GlowStroke, TweenInfo.new(1.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.1, Thickness = 1.5})
            pOut:Play()
            pOut.Completed:Wait()
            pIn:Play()
            pIn.Completed:Wait()
        else
            task.wait(0.5)
        end
    end
end)

